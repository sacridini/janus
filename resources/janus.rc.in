#include <winver.h>

// GLFW automatically uses the icon named GLFW_ICON for the window; Explorer
// uses the first icon in the executable.
GLFW_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/janus.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Janus - raster time series viewer"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "janus"
            VALUE "OriginalFilename", "janus.exe"
            VALUE "ProductName",      "Janus"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
